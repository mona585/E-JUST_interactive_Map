# Anyplace Central Environment Configuration Template
# Copy this file to .env before building:
# cp .env.example .env

# Google Maps API Key
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Anyplace Backend Server Connection Settings
SERVER_HOST=anyplace.ejust.edu.eg
SERVER_PORT=443
SERVER_URL=http://anyplace.ejust.edu.eg:443

# Default API Auth Credentials
API_USERNAME=username
API_PASSWORD=pass
