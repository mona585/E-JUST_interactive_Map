[Unit]
Description=Anyplace MongoDB daily backup (verified mongodump archive)
After=network-online.target mongod.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
# Host provides /etc/anyplace/backup.env with mode 0600. It may define
# BACKUP_DIR, BACKUP_GPG_RECIPIENT, BACKUP_OFFHOST_TARGET, and the MDB_*
# variables; connection details otherwise come from
# /opt/anyplace/server/database/admin/config.sh.
EnvironmentFile=-/etc/anyplace/backup.env
WorkingDirectory=/opt/anyplace/server/database/admin
ExecStart=/opt/anyplace/server/database/admin/backup.sh
