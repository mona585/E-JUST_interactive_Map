# Copy to /etc/anyplace/backup.env, mode 0600, root-owned.
# Values here override the same names in
# /opt/anyplace/server/database/admin/config.sh.
#
# Example (Dockerized production Mongo):
# MDB_MODE=docker
# MDB_DOCKER_CONTAINER=anyplace-mongo
# MDB_DATABASE=anyplace
# MDB_USER=anyplace_app
# MDB_PASS=<from /etc/anyplace/anyplace.env>
# BACKUP_DIR=/var/backups/anyplace
# MAX_BACKUPS=14
#
# Encryption is required before off-host copies are enabled:
# BACKUP_GPG_RECIPIENT=anyplace-backup@ejust.edu.eg
# BACKUP_OFFHOST_TARGET=backup@nas:/srv/anyplace-backups
