#!/usr/bin/env bash
# ==============================================================================
# Anyplace Platform - Automated Production Build & Deployment Packager
# Domain: anyplace.ejust.edu.eg
# ==============================================================================

set -e

# Repository Root Directory
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

# Colors for terminal formatting
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${CYAN}====================================================${NC}"
echo -e "${CYAN}   Anyplace Platform Production Build System         ${NC}"
echo -e "${CYAN}   Target Domain: anyplace.ejust.edu.eg               ${NC}"
echo -e "${CYAN}====================================================${NC}"

# Check for environment configuration or auto-initialize from .env.example
if [ ! -f "$ROOT_DIR/.env" ] && [ -f "$ROOT_DIR/.env.example" ]; then
    echo -e "${YELLOW}[!] Initializing .env from .env.example...${NC}"
    cp "$ROOT_DIR/.env.example" "$ROOT_DIR/.env"
fi

if [ ! -f "$ROOT_DIR/server/.env" ] && [ -f "$ROOT_DIR/server/.env.example" ]; then
    cp "$ROOT_DIR/server/.env.example" "$ROOT_DIR/server/.env"
fi

if [ ! -f "$ROOT_DIR/clients/.env" ] && [ -f "$ROOT_DIR/clients/.env.example" ]; then
    cp "$ROOT_DIR/clients/.env.example" "$ROOT_DIR/clients/.env"
fi

ENV_FILE="$ROOT_DIR/.env"
if [ -f "$ROOT_DIR/server/.env" ]; then
    ENV_FILE="$ROOT_DIR/server/.env"
fi

if [ -f "$ENV_FILE" ]; then
    echo -e "${GREEN}[+] Loading environment settings from $ENV_FILE...${NC}"
    export $(grep -v '^#' "$ENV_FILE" | xargs)
else
    echo -e "${YELLOW}[!] Warning: No .env file found. Using default production settings.${NC}"
    export SERVER_HOST="anyplace.ejust.edu.eg"
    export SERVER_PORT="443"
    export SERVER_URL="http://anyplace.ejust.edu.eg:443"
fi

# Set Java 11 environment
if [ -d "/usr/lib/jvm/java-1.11.0-openjdk-amd64" ]; then
    export JAVA_HOME="/usr/lib/jvm/java-1.11.0-openjdk-amd64"
    export PATH="$JAVA_HOME/bin:$PATH"
fi

BUILD_MODE="${1:---all}"

build_web_apps() {
    echo -e "\n${CYAN}[+] Building Web Applications (Architect, Viewer, Viewer Campus)...${NC}"
    for app_dir in anyplace_architect anyplace_viewer anyplace_viewer_campus; do
        echo -e "${CYAN}    Building $app_dir...${NC}"
        (
            cd "$ROOT_DIR/server/public/$app_dir"
            bower install --allow-root --config.interactive=false
            npm install
            grunt deploy
        )
    done
    echo -e "${GREEN}[✓] Web applications built successfully.${NC}"
}

build_server() {
    echo -e "\n${CYAN}[1/2] Building Anyplace Backend Server Production Package...${NC}"
    build_web_apps
    cd "$ROOT_DIR/server"

    # Auto-install Java 11 if missing
    if ! java -version 2>&1 | grep -q "11\|17"; then
        echo -e "${YELLOW}[!] Java 11 not found. Installing OpenJDK 11...${NC}"
        apt-get install -y openjdk-11-jdk 2>/dev/null || yum install -y java-11-openjdk-devel 2>/dev/null || true
    fi

    # Detect Java Home
    for JH in /usr/lib/jvm/java-1.11.0-openjdk-amd64 /usr/lib/jvm/java-11-openjdk-amd64 /usr/lib/jvm/java-11; do
        if [ -d "$JH" ]; then
            export JAVA_HOME="$JH"
            export PATH="$JAVA_HOME/bin:$PATH"
            break
        fi
    done

    # Auto-install sbt via official apt repo if not present
    if ! command -v sbt >/dev/null 2>&1; then
        echo -e "${YELLOW}[!] sbt not found. Installing via official apt repository...${NC}"
        if command -v apt-get >/dev/null 2>&1; then
            echo "deb https://repo.scala-sbt.org/scalasbt/debian all main" | tee /etc/apt/sources.list.d/sbt.list
            curl -sL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823" | apt-key add -
            apt-get update -qq
            apt-get install -y sbt
        elif command -v yum >/dev/null 2>&1; then
            curl -fL "https://repo.scala-sbt.org/scalasbt/rpm/sbt.repo" -o /etc/yum.repos.d/sbt.repo
            yum install -y sbt
        else
            echo -e "${RED}[X] Cannot install sbt: no supported package manager found.${NC}"
            exit 1
        fi
        echo -e "${GREEN}[✓] sbt installed successfully.${NC}"
    fi

    # Run Play Framework SBT Dist command
    ./sbt clean dist

    
    DIST_ZIP=$(find target/universal -name "anyplace-*.zip" | head -n 1)
    
    if [ -z "$DIST_ZIP" ] || [ ! -f "$DIST_ZIP" ]; then
        echo -e "${RED}[X] Error: Server build failed or dist zip not found.${NC}"
        exit 1
    fi
    
    mkdir -p "$ROOT_DIR/dist"
    cp "$DIST_ZIP" "$ROOT_DIR/dist/anyplace-server-production.zip"
    
    # Create VM deployment script inside dist/
    cat << 'EOF' > "$ROOT_DIR/dist/deploy_to_vm.sh"
#!/usr/bin/env bash
# ==============================================================================
# Script to run Anyplace Server on Target VM
# ==============================================================================

set -e
PORT=${1:-9000}

echo "[+] Unpacking Anyplace Server..."
unzip -q -o anyplace-server-production.zip
SERVER_DIR=$(find . -maxdepth 1 -type d -name "anyplace-*" | head -n 1)

cd "$SERVER_DIR"
chmod +x bin/anyplace

# Remove old PID lock if existing
rm -f RUNNING_PID

if [ -z "\$APPLICATION_SECRET" ]; then
    echo "[!] Error: APPLICATION_SECRET environment variable must be set to run Anyplace Server." >&2
    exit 1
fi

echo "[+] Starting Anyplace Server on port \$PORT..."
./bin/anyplace -Dhttp.port="\$PORT" -Dplay.http.secret.key="\$APPLICATION_SECRET"
EOF
    chmod +x "$ROOT_DIR/dist/deploy_to_vm.sh"
    
    echo -e "${GREEN}[✓] Production Server Bundle Created successfully:${NC}"
    echo -e "    -> ${YELLOW}$ROOT_DIR/dist/anyplace-server-production.zip${NC}"
    echo -e "    -> ${YELLOW}$ROOT_DIR/dist/deploy_to_vm.sh${NC}"
}

build_clients() {
    echo -e "\n${CYAN}[2/2] Building Android Client APKs...${NC}"
    
    mkdir -p "$ROOT_DIR/apk generated"
    
    # Build Legacy Client
    echo -e "${CYAN}[+] Compiling Legacy Anyplace Client...${NC}"
    cd "$ROOT_DIR/clients/android"
    ./gradlew assembleDebug
    cp Anyplace/build/outputs/apk/debug/Anyplace-debug.apk "$ROOT_DIR/apk generated/Anyplace-Legacy.apk"
    
    # Build Modern Clients
    echo -e "${CYAN}[+] Compiling Modern Navigator & Logger Clients...${NC}"
    cd "$ROOT_DIR/clients/android-new"
    ./gradlew assembleDebug
    cp navigator/build/outputs/apk/debug/navigator-debug.apk "$ROOT_DIR/apk generated/Anyplace-Navigator.apk"
    cp logger/build/outputs/apk/debug/logger-debug.apk "$ROOT_DIR/apk generated/Anyplace-Logger.apk"
    
    echo -e "${GREEN}[✓] Android Client APKs Created successfully:${NC}"
    echo -e "    -> ${YELLOW}$ROOT_DIR/apk generated/Anyplace-Legacy.apk${NC}"
    echo -e "    -> ${YELLOW}$ROOT_DIR/apk generated/Anyplace-Navigator.apk${NC}"
    echo -e "    -> ${YELLOW}$ROOT_DIR/apk generated/Anyplace-Logger.apk${NC}"
}

case "$BUILD_MODE" in
    --server)
        build_server
        ;;
    --clients)
        build_clients
        ;;
    --all)
        build_server
        build_clients
        ;;
    *)
        echo "Usage: ./build [--server | --clients | --all]"
        exit 1
        ;;
esac

echo -e "\n${GREEN}====================================================${NC}"
echo -e "${GREEN}   BUILD COMPLETE!                                  ${NC}"
echo -e "${GREEN}   To deploy server to another VM:                  ${NC}"
echo -e "${YELLOW}   scp -r dist/ user@your-vm-ip:/opt/anyplace      ${NC}"
echo -e "${YELLOW}   ssh user@your-vm-ip 'cd /opt/anyplace && ./deploy_to_vm.sh'${NC}"
echo -e "${GREEN}====================================================${NC}"
