# Anyplace Server Environment Configuration Template
# Copy this file to server/.env before building:
# cp server/.env.example server/.env

# Application Secrets
APPLICATION_SECRET=CHANGE_ME_APPLICATION_SECRET

# MongoDB Settings (initial deployment is loopback-only)
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=anyplace
MONGODB_USERNAME=CHANGE_ME_MONGODB_USERNAME
MONGODB_PASSWORD=CHANGE_ME_MONGODB_PASSWORD

# Public domain/TLS configuration is intentionally deferred to Phase 8.
