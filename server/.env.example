# Anyplace Server Environment Configuration Template
# Copy this file to server/.env before building:
# cp server/.env.example server/.env

# Server Network Settings
SERVER_HOST=anyplace.ejust.edu.eg
SERVER_PORT=443
SERVER_URL=http://anyplace.ejust.edu.eg:443
APPLICATION_SECRET=YOUR_APPLICATION_SECRET

# Database Settings
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_NAME=anyplace

# Default API Auth Credentials
DEFAULT_API_USERNAME=username
DEFAULT_API_PASSWORD=pass
